<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DicomTestTool.Controls.DateField">
  <StackPanel Spacing="2">
    <TextBlock x:Name="LabelText" Classes="caption" />
    <StackPanel Orientation="Horizontal" Spacing="2">
      <TextBox x:Name="Input" Width="110" />
      <Button x:Name="CalendarButton" Padding="6,4" ToolTip.Tip="Kalender">
        <TextBlock Classes="icon" Text="&#xE787;" FontSize="14" />
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <StackPanel Spacing="8" Width="300">
              <Calendar x:Name="Cal" HorizontalAlignment="Center" />
              <WrapPanel x:Name="Quick" HorizontalAlignment="Center" />
              <TextBlock x:Name="Hint" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </StackPanel>
  </StackPanel>
</UserControl>
