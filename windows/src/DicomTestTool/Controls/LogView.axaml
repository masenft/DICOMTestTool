<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:DicomTestTool.Core"
             xmlns:c="using:DicomTestTool.Controls"
             x:Class="DicomTestTool.Controls.LogView"
             Background="{DynamicResource AppLogBackground}">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="0,0,0,1" Padding="10,5">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Content="Kopieren" Click="OnCopy" />
          <Button Content="Exportieren …" Click="OnExport" x:Name="ExportButton" />
          <Button Content="Leeren" Click="OnClear" />
        </StackPanel>
        <TextBlock Text="Protokoll" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <ListBox x:Name="Lines" Background="Transparent" Padding="4,2" SelectionMode="Multiple">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="6,0" />
          <Setter Property="MinHeight" Value="18" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="core:LogEntry">
          <TextBlock Classes="mono" FontSize="12" TextWrapping="NoWrap" Text="{Binding Converter={x:Static c:LogLineConverter.Instance}}"
                     Classes.error="{Binding IsError}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
