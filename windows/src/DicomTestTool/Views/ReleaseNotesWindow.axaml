<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:DicomTestTool.Services"
        x:Class="DicomTestTool.Views.ReleaseNotesWindow"
        x:DataType="s:UpdateService"
        Title="Update verfügbar – DICOM Test Tool für Windows" Width="640" Height="540" MinWidth="480" MinHeight="360"
        Icon="/Assets/app.ico" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14" Margin="0,0,0,12">
      <Image Source="/Assets/AppIcon-256.png" Width="64" Height="64" />
      <StackPanel VerticalAlignment="Center" Spacing="3">
        <TextBlock Text="Eine neue Version von DICOM Test Tool für Windows ist verfügbar" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock x:Name="VersionLine" Classes="secondary" />
      </StackPanel>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="Später" IsCancel="True" Click="OnLater" />
        <Button Classes="accent" Content="Installieren und neu starten" IsDefault="True" Click="OnInstall" IsEnabled="{Binding !IsInstalling}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Diese Version überspringen" Click="OnSkip" />
        <Button Content="Auf GitHub ansehen" Click="OnGitHub" />
      </StackPanel>
    </DockPanel>
    <TextBlock DockPanel.Dock="Bottom" Classes="caption" Text="{Binding StatusText}" Margin="0,8,0,0" />
    <Border BorderBrush="{DynamicResource AppPanelBorder}" BorderThickness="1" Background="{DynamicResource AppLogBackground}">
      <ScrollViewer>
        <StackPanel x:Name="Notes" Margin="12" Spacing="5" />
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
