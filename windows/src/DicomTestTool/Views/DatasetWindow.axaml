<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:DicomTestTool.Core"
        x:Class="DicomTestTool.Views.DatasetWindow"
        Width="920" Height="600" MinWidth="600" MinHeight="300"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="Als Text kopieren" Click="OnCopy" />
        <Button Content="Schließen" Click="OnClose" IsDefault="True" IsCancel="True" />
      </StackPanel>
      <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
    </DockPanel>
    <TextBox DockPanel.Dock="Top" x:Name="Filter" Watermark="Filter (Tag, Name oder Wert)" Margin="0,0,0,6" />
    <DataGrid x:Name="Grid" x:DataType="core:TagRow">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="170" FontFamily="{StaticResource MonoFont}" />
        <DataGridTextColumn Header="VR" Binding="{Binding VR}" Width="48" FontFamily="{StaticResource MonoFont}" />
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="230" />
        <DataGridTextColumn Header="Länge" Binding="{Binding Length}" Width="70" />
        <DataGridTextColumn Header="Wert" Binding="{Binding Value}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
